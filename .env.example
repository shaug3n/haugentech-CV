NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# The site owner's login email. Must match EXACTLY the email of the Supabase
# auth user you created in Authentication -> Users, and the address hardcoded in
# `public.is_site_owner()` in supabase/migrations/0001_init.sql. Every admin
# write checks the signed-in user's email against this value and refuses if it
# does not match (or if this var is missing), so the admin panel is read-only
# until it is set — in local dev AND in Vercel's env vars.
ADMIN_EMAIL=sondre.haugen99@gmail.com
# Not read by the app today; reserved for future server-side jobs:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
